// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// Month
// ---------------------------------------------------------

model Month {
  id                   String                @id @default(uuid())
  identifier           String                @unique // e.g., "June 2026"
  incomes              Income[]
  monthlyBills         MonthlyBill[]
  creditCardStatements CreditCardStatement[]
  investmentSnapshots  InvestmentSnapshot[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

// ---------------------------------------------------------
// Cash Flow (Income, Bills, Credit Cards)
// ---------------------------------------------------------

model Income {
  id        String   @id @default(uuid())
  monthId   String
  month     Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)
  source    String
  amount    Decimal  @db.Decimal(12, 2)
  isPaid    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecurringIncome {
  id        String   @id @default(uuid())
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecurringBill {
  id         String   @id @default(uuid())
  name       String
  company    String?
  dayOfMonth Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MonthlyBill {
  id         String   @id @default(uuid())
  monthId    String
  month      Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)
  name       String
  company    String?
  amount     Decimal  @db.Decimal(12, 2)
  dayOfMonth Int?
  isPaid     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CreditCard {
  id         String                @id @default(uuid())
  name       String                @unique
  active     Boolean               @default(true)
  statements CreditCardStatement[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

model CreditCardStatement {
  id           String     @id @default(uuid())
  creditCardId String
  creditCard   CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  monthId      String
  month        Month      @relation(fields: [monthId], references: [id], onDelete: Cascade)
  balance      Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([creditCardId, monthId])
}

// ---------------------------------------------------------
// Net Worth (Investments & Assets)
// ---------------------------------------------------------

enum AccountCategory {
  Pensions
  StockISA
  Shares
  Savings
  CurrentAccount
}

model InvestmentAccount {
  id        String               @id @default(uuid())
  name      String               @unique
  category  AccountCategory      @default(Savings)
  active    Boolean              @default(true)
  snapshots InvestmentSnapshot[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model InvestmentSnapshot {
  id        String            @id @default(uuid())
  accountId String
  account   InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  monthId   String
  month     Month             @relation(fields: [monthId], references: [id], onDelete: Cascade)
  balance   Decimal           @db.Decimal(12, 2)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([accountId, monthId])
}

// ---------------------------------------------------------
// Settings
// ---------------------------------------------------------

model Settings {
  id       String @id @default("global")
  currency String @default("$")
}
