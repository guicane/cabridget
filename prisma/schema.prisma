// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Module A: Cash Flow

model Month {
  id                  String               @id @default(uuid())
  identifier          String               @unique // e.g., "June 2026"
  ledgerEntries       LedgerEntry[]
  investmentSnapshots InvestmentSnapshot[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

enum EntryType {
  Income
  Bill
  CreditCardPayment
}

model LedgerEntry {
  id          String    @id @default(uuid())
  monthId     String
  month       Month     @relation(fields: [monthId], references: [id], onDelete: Cascade)
  type        EntryType
  description String
  amount      Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Module B: Net Worth

model InvestmentAccount {
  id        String               @id @default(uuid())
  name      String               @unique
  snapshots InvestmentSnapshot[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model InvestmentSnapshot {
  id        String            @id @default(uuid())
  accountId String
  account   InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  monthId   String
  month     Month             @relation(fields: [monthId], references: [id], onDelete: Cascade)
  balance   Decimal           @db.Decimal(12, 2)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([accountId, monthId])
}
